# moondap 배포 설정 템플릿
#
#   cp scripts/deploy.env.example scripts/deploy.env
#   vi scripts/deploy.env
#
# deploy.env 는 .gitignore 의 `*.env` 규칙에 걸려 커밋되지 않는다.
# 비밀번호는 이 파일에 적지 않는다 — SSH 키 인증을 쓴다(README 참고).

# --- 접속 대상 ---
SSH_HOST=
SSH_USER=
SSH_PORT=22
# 배포 전용 SSH 키. 비워 두면 ~/.ssh/moondap_deploy_ed25519 를 쓴다.
SSH_KEY=


# 톰캣 webapps 디렉터리(절대경로)
REMOTE_WEBAPPS=/moondap/tomcat/webapps

# --- 톰캣 재기동 ---
# SSH 셸 접속이 되면 true. Cafe24 관리자 패널에서만 재시작 가능하면 false 로 두고
# 업로드까지만 자동화한 뒤 재시작은 수동으로 한다.
RESTART_TOMCAT=false

# RESTART_TOMCAT=true 일 때만 사용. bin/shutdown.sh, bin/startup.sh 의 상위 경로.
CATALINA_HOME=/moondap/tomcat
